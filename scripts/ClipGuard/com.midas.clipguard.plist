<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.midas.clipguard</string>
    <key>ProgramArguments</key>
    <array>
        <!-- 默认安装路径为 ~/.local/bin/clipguard -->
        <string>/bin/bash</string>
        <string>-c</string>
        <string>"$HOME/.local/bin/clipguard" check</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/clipguard_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/clipguard_stderr.log</string>
</dict>
</plist>
